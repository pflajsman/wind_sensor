{
  "schema": "devcap1.schema.json",
  "uuid": "774d2c0e-cd4c-4e37-b098-9f72dc7a4d02",
  "manufacturername": "DIY",
  "modelid": "awning-protection",
  "vendor": "DIY",
  "product": "Awning protection sensor",
  "sleeper": true,
  "supportsMgmtBind": false,
  "status": "Gold",
  "comment": "ESP32-H2 Zigbee sleepy end device, one endpoint (0x0a): Basic 0x0000, Identify 0x0003, Power Configuration 0x0001 (battery), Occupancy Sensing 0x0406 (the 'awning protected' value; sensitivity on attr 0x0012). Structure follows the official deCONZ presence-sensor DDFs (e.g. sonoff/snzb-03p_motion_sensor.json): every presence subdevice there has config/on, config/reachable and state/lastupdated. manufacturername/modelid MUST match the device's Basic cluster attrs 0x0004/0x0005.",
  "subdevices": [
    {
      "type": "ZHAPresence",
      "restapi": "/sensors",
      "uuid": [
        "$address.ext",
        "0x0a",
        "0x0406"
      ],
      "fingerprint": {
        "profile": "0x0104",
        "device": "0x0107",
        "endpoint": "0x0a",
        "in": [
          "0x0000",
          "0x0001",
          "0x0406"
        ]
      },
      "items": [
        {
          "name": "attr/id"
        },
        {
          "name": "attr/lastannounced"
        },
        {
          "name": "attr/lastseen"
        },
        {
          "name": "attr/manufacturername"
        },
        {
          "name": "attr/modelid"
        },
        {
          "name": "attr/name"
        },
        {
          "name": "attr/swversion"
        },
        {
          "name": "attr/type"
        },
        {
          "name": "attr/uniqueid"
        },
        {
          "name": "config/battery",
          "refresh.interval": 86400,
          "awake": true,
          "read": {
            "fn": "zcl:attr",
            "ep": 10,
            "cl": "0x0001",
            "at": "0x0021"
          },
          "parse": {
            "fn": "zcl:attr",
            "ep": 10,
            "cl": "0x0001",
            "at": "0x0021",
            "eval": "Item.val = Attr.val / 2"
          },
          "default": 0
        },
        {
          "name": "config/on"
        },
        {
          "name": "config/reachable"
        },
        {
          "name": "config/sensitivity",
          "refresh.interval": 86400,
          "read": {
            "fn": "zcl:attr",
            "ep": 10,
            "cl": "0x0406",
            "at": "0x0012"
          },
          "parse": {
            "fn": "zcl:attr",
            "ep": 10,
            "cl": "0x0406",
            "at": "0x0012",
            "eval": "Item.val = Attr.val"
          },
          "write": {
            "fn": "zcl:attr",
            "ep": 10,
            "cl": "0x0406",
            "at": "0x0012",
            "dt": "0x20",
            "eval": "Item.val"
          }
        },
        {
          "name": "state/lastupdated"
        },
        {
          "name": "state/presence",
          "awake": true,
          "read": {
            "fn": "none"
          },
          "parse": {
            "fn": "zcl:attr",
            "ep": 10,
            "cl": "0x0406",
            "at": "0x0000",
            "eval": "Item.val = (Attr.val & 1) != 0"
          },
          "default": false
        }
      ]
    }
  ],
  "bindings": [
    {
      "bind": "unicast",
      "src.ep": 10,
      "cl": "0x0406",
      "report": [
        {
          "at": "0x0000",
          "dt": "0x18",
          "min": 1,
          "max": 3600
        }
      ]
    },
    {
      "bind": "unicast",
      "src.ep": 10,
      "cl": "0x0001",
      "report": [
        {
          "at": "0x0021",
          "dt": "0x20",
          "min": 3600,
          "max": 3600,
          "change": "0x00000000"
        }
      ]
    }
  ]
}
