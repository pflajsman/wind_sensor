{
  "schema": "devcap1.schema.json",
  "manufacturername": "DIY",
  "modelid": "awning-wind-sensor",
  "product": "Awning wind protection sensor",
  "sleeper": true,
  "status": "Gold",
  "comment": "ADXL345 + ESP32-H2 Zigbee end device. Four Analog Input endpoints (EP 10-13, cluster 0x000C) carry movement metrics; battery via Power Configuration (0x0001). See spec §7, §11. Firmware unchanged from Z2M build. modelid/manufacturername below MUST match what the device reports on join (Phoscon -> device -> Basic cluster 0x0000, attrs 0x0004/0x0005).",

  "subdevices": [
    {
      "type": "$TYPE_CONSUMPTION_SENSOR",
      "restapi": "/sensors",
      "uuid": ["$address.ext", "0x0a", "0x000c"],
      "fingerprint": {
        "profile": "0x0104",
        "device": "0x000c",
        "endpoint": "0x0a",
        "in": ["0x0000", "0x000c"]
      },
      "items": [
        { "name": "attr/id" },
        { "name": "attr/lastannounced" },
        { "name": "attr/lastseen" },
        { "name": "attr/manufacturername" },
        { "name": "attr/modelid" },
        { "name": "attr/name" },
        { "name": "attr/swversion" },
        { "name": "attr/type" },
        { "name": "attr/uniqueid" },
        {
          "name": "state/movement_rms",
          "description": "AC-energy movement intensity, mg (spec §6)",
          "parse": { "at": "0x0055", "cl": "0x000c", "ep": 10, "eval": "Item.val = Attr.val" },
          "read": { "at": "0x0055", "cl": "0x000c", "ep": 10 },
          "refresh.interval": 300
        }
      ]
    },
    {
      "type": "$TYPE_CONSUMPTION_SENSOR",
      "restapi": "/sensors",
      "uuid": ["$address.ext", "0x0b", "0x000c"],
      "fingerprint": {
        "profile": "0x0104",
        "device": "0x000c",
        "endpoint": "0x0b",
        "in": ["0x000c"]
      },
      "items": [
        { "name": "attr/id" },
        { "name": "attr/lastseen" },
        { "name": "attr/manufacturername" },
        { "name": "attr/modelid" },
        { "name": "attr/name" },
        { "name": "attr/type" },
        { "name": "attr/uniqueid" },
        {
          "name": "state/movement_peak",
          "description": "Peak absolute deviation, mg (spec §6)",
          "parse": { "at": "0x0055", "cl": "0x000c", "ep": 11, "eval": "Item.val = Attr.val" },
          "read": { "at": "0x0055", "cl": "0x000c", "ep": 11 },
          "refresh.interval": 300
        }
      ]
    },
    {
      "type": "$TYPE_CONSUMPTION_SENSOR",
      "restapi": "/sensors",
      "uuid": ["$address.ext", "0x0c", "0x000c"],
      "fingerprint": {
        "profile": "0x0104",
        "device": "0x000c",
        "endpoint": "0x0c",
        "in": ["0x000c"]
      },
      "items": [
        { "name": "attr/id" },
        { "name": "attr/lastseen" },
        { "name": "attr/manufacturername" },
        { "name": "attr/modelid" },
        { "name": "attr/name" },
        { "name": "attr/type" },
        { "name": "attr/uniqueid" },
        {
          "name": "state/tilt_pitch",
          "description": "Mean-vector pitch, degrees (spec §6)",
          "parse": { "at": "0x0055", "cl": "0x000c", "ep": 12, "eval": "Item.val = Attr.val" },
          "read": { "at": "0x0055", "cl": "0x000c", "ep": 12 },
          "refresh.interval": 300
        }
      ]
    },
    {
      "type": "$TYPE_CONSUMPTION_SENSOR",
      "restapi": "/sensors",
      "uuid": ["$address.ext", "0x0d", "0x000c"],
      "fingerprint": {
        "profile": "0x0104",
        "device": "0x000c",
        "endpoint": "0x0d",
        "in": ["0x000c", "0x0001"]
      },
      "items": [
        { "name": "attr/id" },
        { "name": "attr/lastseen" },
        { "name": "attr/manufacturername" },
        { "name": "attr/modelid" },
        { "name": "attr/name" },
        { "name": "attr/type" },
        { "name": "attr/uniqueid" },
        {
          "name": "state/tilt_roll",
          "description": "Mean-vector roll, degrees (spec §6)",
          "parse": { "at": "0x0055", "cl": "0x000c", "ep": 13, "eval": "Item.val = Attr.val" },
          "read": { "at": "0x0055", "cl": "0x000c", "ep": 13 },
          "refresh.interval": 300
        },
        {
          "name": "config/battery",
          "description": "Battery percentage via Power Configuration cluster (spec §7)",
          "parse": { "at": "0x0021", "cl": "0x0001", "ep": 13, "eval": "Item.val = Attr.val / 2" },
          "read": { "at": "0x0021", "cl": "0x0001", "ep": 13 },
          "refresh.interval": 3600
        }
      ]
    }
  ],

  "bindings": [
    {
      "bind": "unicast",
      "src.ep": 10,
      "cl": "0x000c",
      "report": [ { "at": "0x0055", "dt": "0x39", "min": 30, "max": 3600, "change": "0x00000001" } ]
    },
    {
      "bind": "unicast",
      "src.ep": 11,
      "cl": "0x000c",
      "report": [ { "at": "0x0055", "dt": "0x39", "min": 30, "max": 3600, "change": "0x00000001" } ]
    },
    {
      "bind": "unicast",
      "src.ep": 12,
      "cl": "0x000c",
      "report": [ { "at": "0x0055", "dt": "0x39", "min": 30, "max": 3600, "change": "0x00000001" } ]
    },
    {
      "bind": "unicast",
      "src.ep": 13,
      "cl": "0x000c",
      "report": [ { "at": "0x0055", "dt": "0x39", "min": 30, "max": 3600, "change": "0x00000001" } ]
    },
    {
      "bind": "unicast",
      "src.ep": 13,
      "cl": "0x0001",
      "report": [ { "at": "0x0021", "dt": "0x20", "min": 3600, "max": 3600, "change": "0x00" } ]
    }
  ]
}
